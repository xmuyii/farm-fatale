# Farm Fatale Environment Variables

# --- Client Environment Variables (Vite) ---
# WebSocket URL pointing to the Colyseus game server (e.g., ws://localhost:2567 or wss://farm-fatale-server.up.railway.app)
VITE_SERVER_URL="ws://localhost:2567"

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"

# Supabase Anonymous Public API Key (safe for browser client)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Server Environment Variables (Colyseus & Railway) ---
# Port for Colyseus Game Server (Railway automatically injects PORT)
PORT=2567

# Supabase Project URL for the authoritative game server
SUPABASE_URL="https://your-supabase-project.supabase.co"

# Supabase Service Role Secret Key (Server-only, NEVER expose to client)
# Used by authoritative game server to insert match history and upsert leaderboards
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Allowed CORS origin for the game server (e.g. https://farm-fatale.vercel.app)
CLIENT_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
